{
  "description": "SuperMemory local-first capture and bounded session context.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/hook.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\scripts\\hook.mjs\"",
            "timeout": 2,
            "statusMessage": "Loading governed SuperMemory context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/hook.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\scripts\\hook.mjs\"",
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/hook.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\scripts\\hook.mjs\"",
            "timeout": 2
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/hook.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\scripts\\hook.mjs\"",
            "timeout": 2
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/hook.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\scripts\\hook.mjs\"",
            "timeout": 2
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/hook.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\scripts\\hook.mjs\"",
            "timeout": 2
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "other",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/hook.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\scripts\\hook.mjs\"",
            "timeout": 1
          }
        ]
      }
    ]
  }
}
