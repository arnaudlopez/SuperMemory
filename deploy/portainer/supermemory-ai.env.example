# Non-secret Portainer stack variables. Create the three external Docker
# secrets separately; never paste their values into this file.
SUPERMEMORY_SERVER_BIND=127.0.0.1

OLLAMA_IMAGE=docker.io/ollama/ollama@sha256:4dea9fb511947e24a84237bb636b0203abcb2ff0d3fbc7b4ff865deb91362131
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_KEEP_ALIVE=5m
OLLAMA_MEMORY_LIMIT=10g
OLLAMA_CPUS=3.0

HINDSIGHT_IMAGE=ghcr.io/vectorize-io/hindsight@sha256:6364c3c5f1e551447976d6c3ab369040d0237c0980f10f911d76d981290913b6
HINDSIGHT_MEMORY_LIMIT=3g
HINDSIGHT_CPUS=1.0

NEO4J_IMAGE=neo4j:5.26.28
NEO4J_HEAP_INITIAL=1g
NEO4J_HEAP_MAX=2g
NEO4J_PAGECACHE=1g
NEO4J_MEMORY_LIMIT=5g
NEO4J_CPUS=2.0

GRAPHD_IMAGE=supermemory-graphd:2.0.0
GRAPHD_PORT=8787
GRAPHD_MEMORY_LIMIT=512m
GRAPHD_CPUS=0.5

# Docker Standalone secret-file directory on the server. Both files must be
# root-owned, mode 0600, and are mounted under /run/secrets by Compose.
SUPERMEMORY_SECRETS_DIR=/opt/supermemory/secrets
