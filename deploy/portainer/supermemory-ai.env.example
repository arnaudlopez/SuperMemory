# Non-secret Portainer stack variables. Secret values stay in the mounted
# files under SUPERMEMORY_SECRETS_DIR; never paste them into this file.
COMPOSE_PROJECT_NAME=supermemory-ai
SUPERMEMORY_SERVER_BIND=127.0.0.1

HINDSIGHT_IMAGE=supermemory-hindsight:0.9.0
HINDSIGHT_BASE_IMAGE=ghcr.io/vectorize-io/hindsight@sha256:6364c3c5f1e551447976d6c3ab369040d0237c0980f10f911d76d981290913b6
HINDSIGHT_MEMORY_LIMIT=3g
HINDSIGHT_CPUS=1.0
HINDSIGHT_BANK_ID=supermemory-local

SUPERMEMORY_RUNTIME_IMAGE=supermemory-runtime:5.0.0
CODEX_CLI_VERSION=0.146.1
SUPERMEMORY_CODEX_TIMEOUT_MS=120000
SUPERMEMORY_DAEMON_MEMORY_LIMIT=2g
SUPERMEMORY_DAEMON_CPUS=2.0
SUPERMEMORY_WEB_MEMORY_LIMIT=1g
SUPERMEMORY_WEB_CPUS=1.0

# The llm block in runtime-contract.json is the only provider/model selector
# shared by the external Home 101 Hermes agent, Hindsight and the canonical
# pipeline. Supported providers: openai-codex or openrouter. No fallback is
# accepted. Hermes itself is not part of this Z2 stack.

NEO4J_IMAGE=neo4j:5.26.28
NEO4J_HEAP_INITIAL=1g
NEO4J_HEAP_MAX=2g
NEO4J_PAGECACHE=1g
NEO4J_MEMORY_LIMIT=5g
NEO4J_CPUS=2.0

GRAPHD_IMAGE=supermemory-graphd:2.0.0
GRAPHD_PORT=8787
GRAPHD_MEMORY_LIMIT=512m
GRAPHD_CPUS=0.5

# Docker Standalone secret-file directory on the server. The agent_token and
# optional OpenRouter credential remain root-owned mode 0440; Codex OAuth lives
# only in SUPERMEMORY_CODEX_AUTH_DIR.
SUPERMEMORY_SECRETS_DIR=/opt/supermemory/secrets
SUPERMEMORY_CONFIG_DIR=/opt/supermemory/config
SUPERMEMORY_CODEX_AUTH_DIR=/opt/supermemory/codex-auth
SUPERMEMORY_VAULT_DIR=/opt/supermemory/vault
SUPERMEMORY_RUNTIME_DIR=/opt/supermemory/runtime
SUPERMEMORY_BACKUPS_DIR=/opt/supermemory/backups
