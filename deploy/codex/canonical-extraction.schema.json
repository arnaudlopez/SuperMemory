{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["claim_key", "text", "fact_class", "explicit", "authenticated", "inferred", "ttl_ms", "temporal_expression", "event_time", "entities", "relations", "ontology_proposals"],
  "properties": {
    "claim_key": { "type": "string", "minLength": 1 },
    "text": { "type": "string", "minLength": 1 },
    "fact_class": {
      "type": "string",
      "enum": ["machine_state", "source_state", "user_decision", "user_preference", "project_constraint", "external_fact", "derived_observation", "permission", "high_impact_fact"]
    },
    "explicit": { "type": "boolean" },
    "authenticated": { "type": "boolean" },
    "inferred": { "type": "boolean" },
    "ttl_ms": { "type": ["integer", "null"], "minimum": 1 },
    "temporal_expression": { "type": "string" },
    "event_time": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "earliest", "latest", "granularity", "anchor_timestamp", "normalization"],
          "properties": {
            "kind": { "type": "string", "enum": ["instant", "interval", "uncertain"] },
            "earliest": { "type": ["string", "null"] },
            "latest": { "type": ["string", "null"] },
            "granularity": { "type": "string", "enum": ["exact", "minute", "hour", "day", "week", "month", "year", "unknown"] },
            "anchor_timestamp": { "type": "string" },
            "normalization": { "type": "string", "enum": ["explicit", "relative_expression", "inferred"] }
          }
        }
      ]
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["binding_id", "canonical_name", "entity_type", "aliases"],
        "properties": {
          "binding_id": { "type": "string", "minLength": 1 },
          "canonical_name": { "type": "string", "minLength": 1 },
          "entity_type": { "type": "string", "minLength": 1 },
          "aliases": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relation_key", "subject_binding_id", "predicate", "object_binding_id", "valid_from", "valid_to", "temporal_expression", "event_time", "supersedes_relation_ids", "contradicts_relation_ids"],
        "properties": {
          "relation_key": { "type": "string", "minLength": 1 },
          "subject_binding_id": { "type": "string", "minLength": 1 },
          "predicate": { "type": "string", "minLength": 1 },
          "object_binding_id": { "type": "string", "minLength": 1 },
          "valid_from": { "type": ["string", "null"] },
          "valid_to": { "type": ["string", "null"] },
          "temporal_expression": { "type": "string" },
          "event_time": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "earliest", "latest", "granularity", "anchor_timestamp", "normalization"],
                "properties": {
                  "kind": { "type": "string", "enum": ["instant", "interval", "uncertain"] },
                  "earliest": { "type": ["string", "null"] },
                  "latest": { "type": ["string", "null"] },
                  "granularity": { "type": "string", "enum": ["exact", "minute", "hour", "day", "week", "month", "year", "unknown"] },
                  "anchor_timestamp": { "type": "string" },
                  "normalization": { "type": "string", "enum": ["explicit", "relative_expression", "inferred"] }
                }
              }
            ]
          },
          "supersedes_relation_ids": { "type": "array", "items": { "type": "string" } },
          "contradicts_relation_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "ontology_proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "name"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["add_entity_type", "add_relation_type", "rename", "merge", "delete", "narrow"]
          },
          "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{1,63}$" }
        }
      }
    }
  }
}
